@page
@model MultilingualJournalApp.Pages.Journal.DetailsModel
@{
    ViewData["Title"] = "Journal Entry Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2>@Model.JournalEntry.Title</h2>
                        <span class="badge bg-primary">@Model.JournalEntry.Language.ToUpper()</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">
                            <i class="fas fa-calendar"></i> 
                            Created on @Model.JournalEntry.CreatedDate.ToString("MMMM dd, yyyy 'at' h:mm tt")
                        </small>
                    </div>

                    <div class="content-area">
                        <p class="lead">@Html.Raw(Model.JournalEntry.Content.Replace("\n", "<br>"))</p>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Journal
                        </a>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.JournalEntry.Id" class="btn btn-outline-primary">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.JournalEntry.Id" class="btn btn-outline-danger">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>