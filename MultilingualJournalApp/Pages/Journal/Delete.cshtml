@page
@model MultilingualJournalApp.Pages.Journal.DeleteModel
@{
    ViewData["Title"] = "Delete Journal Entry";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2><i class="fas fa-exclamation-triangle"></i> @ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> Are you sure you want to delete this entry? This action cannot be undone.
                    </div>

                    <div class="mb-3">
                        <h4>@Model.JournalEntry.Title</h4>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted">
                                <i class="fas fa-calendar"></i> 
                                @Model.JournalEntry.CreatedDate.ToString("MMMM dd, yyyy 'at' h:mm tt")
                            </small>
                            <span class="badge bg-primary">@Model.JournalEntry.Language.ToUpper()</span>
                        </div>
                    </div>

                    <div class="content-preview bg-light p-3 mb-3">
                        <p>@(Model.JournalEntry.Content.Length > 200 ? Model.JournalEntry.Content.Substring(0, 200) + "..." : Model.JournalEntry.Content)</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="JournalEntry.Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Delete Entry
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>